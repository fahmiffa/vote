generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model candidate {
  id        Int      @id @default(autoincrement())
  name      String
  img       String
  createdAt DateTime @default(now())
  res       res[]
  vote      vote[]
}

model device {
  id        Int      @id @default(autoincrement())
  primary   Int
  secondary Int
  createdAt DateTime @default(now())
}

model head {
  id        Int      @id @default(autoincrement())
  name      String
  img       String
  status    Int
  createdAt DateTime @default(now())
  res       res[]
  vote      vote[]
}

model peserta {
  id        Int      @id @default(autoincrement())
  name      String
  kelas     String
  status    Int
  createdAt DateTime @default(now())
}

model res {
  id          Int       @id @default(autoincrement())
  candidateId Int
  headId      Int
  createdAt   DateTime  @default(now())
  candidate   candidate @relation(fields: [candidateId], references: [id], map: "Res_candidateId_fkey")
  head        head      @relation(fields: [headId], references: [id], map: "Res_headId_fkey")

  @@index([candidateId], map: "Res_candidateId_fkey")
  @@index([headId], map: "Res_headId_fkey")
}

model user {
  id        Int      @id @default(autoincrement())
  name      String?
  email     String   @unique(map: "User_email_key")
  password  String
  role      Int
  createdAt DateTime @default(now())
}

model vote {
  id          Int       @id @default(autoincrement())
  candidateId Int
  headId      Int
  createdAt   DateTime  @default(now())
  candidate   candidate @relation(fields: [candidateId], references: [id], map: "Vote_candidateId_fkey")
  head        head      @relation(fields: [headId], references: [id], map: "Vote_headId_fkey")

  @@index([candidateId], map: "Vote_candidateId_fkey")
  @@index([headId], map: "Vote_headId_fkey")
}
